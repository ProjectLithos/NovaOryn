<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Project" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>NovaOryn Kernel 0.0.40</Name>
    <Description>Create a freestanding C# NovaOryn x64 UEFI kernel that builds and runs in QEMU from Visual Studio.</Description>
    <Icon>NovaOrynKernel.ico</Icon>
    <ProjectType>CSharp</ProjectType>
    <LanguageTag>csharp</LanguageTag>
    <PlatformTag>other</PlatformTag>
    <ProjectTypeTag>other</ProjectTypeTag>
    <TemplateID>NovaOryn.Kernel.Project</TemplateID>
    <DefaultName>NovaOrynKernel</DefaultName>
    <SortOrder>1</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <ProvideDefaultName>true</ProvideDefaultName>
  </TemplateData>
  <TemplateContent>
    <Project File="NovaOrynKernel.csproj" ReplaceParameters="true">
      <Folder Name="Kernel" TargetFolderName="Kernel">
        <ProjectItem ReplaceParameters="true">Kernel\Kernel.cs</ProjectItem>
      </Folder>
      <Folder Name="Runtime" TargetFolderName="Runtime">
        <ProjectItem ReplaceParameters="true">Runtime\CoreLib.cs</ProjectItem>
      </Folder>
      <Folder Name="Boot" TargetFolderName="Boot">
        <ProjectItem ReplaceParameters="true">Boot\BootContext.cs</ProjectItem>
      </Folder>
      <Folder Name="Console" TargetFolderName="Console">
        <ProjectItem ReplaceParameters="true">Console\FramebufferConsole.cs</ProjectItem>
        <ProjectItem ReplaceParameters="true">Console\BitmapFont.cs</ProjectItem>
      </Folder>
      <ProjectItem ReplaceParameters="true">NovaOrynProject.json</ProjectItem>
    </Project>
  </TemplateContent>
</VSTemplate>
