<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <NoConfig>true</NoConfig>
    <RuntimeMetadataVersion>v4.0.30319</RuntimeMetadataVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <AssemblyName>NovaOryn.Kernel.Bootstrap</AssemblyName>
    <RootNamespace>NovaOryn.Kernel.Bootstrap</RootNamespace>
    <NovaOrynSystemModule>NovaOryn.Freestanding.CoreLib</NovaOrynSystemModule>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NovaOrynProject>true</NovaOrynProject>
    <NovaOrynSdkRoot Condition="'$(NovaOrynSdkRoot)' == '' and '$(NOVAORYN_SDK_ROOT)' != ''">$(NOVAORYN_SDK_ROOT)</NovaOrynSdkRoot>
    <NovaOrynSdkRoot Condition="'$(NovaOrynSdkRoot)' == ''">C:\NovaOryn</NovaOrynSdkRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Kernel\Kernel.cs" />
    <ProjectReference Include="Sdk\NovaOryn.Freestanding.CoreLib\NovaOryn.Freestanding.CoreLib.csproj" />
    <ProjectReference Include="Sdk\NovaOryn.Kernel.Console\NovaOryn.Kernel.Console.csproj" />
    <ProjectReference Include="Sdk\NovaOryn.Kernel.Platform.X64\NovaOryn.Kernel.Platform.X64.csproj" />
    <None Include="NovaOrynProject.json" />
    <None Include="Build-Kernel.bat" />
    <None Include="Run-Kernel.bat" />
    <None Include="README-Kernel.md" />
    <None Include="Sdk\**\*" Visible="false" />
  </ItemGroup>
</Project>
